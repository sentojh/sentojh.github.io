{%- comment -%}
====================================================
SELECTED PUBLICATIONS — ALL-IN-LIQUID VERSION
모든 레이아웃 / 간격 / 크기 여기서 제어
====================================================
{%- endcomment -%}

{%- assign IMG_WIDTH = "260px" -%}
{%- assign IMG_RATIO = "4 / 3" -%}
{%- assign GAP = "2rem" -%}
{%- assign ITEM_MARGIN = "3.5rem" -%}

<h2 style="margin-bottom:2rem;">Selected Publications</h2>

{% for block in site.data.selected_publications %}

<h3 style="
  margin-top:2.8rem;
  margin-bottom:1.4rem;
  font-size:1.4rem;
  font-weight:500;
">
  {{ block.year }}
</h3>

{% for pub in block.items %}
<div style="
  display:grid;
  grid-template-columns: {{ IMG_WIDTH }} 1fr;
  gap: {{ GAP }};
  margin-bottom: {{ ITEM_MARGIN }};
  align-items:start;
">

  <!-- LEFT: image grid -->
  <div style="
    display:grid;
    grid-template-columns: repeat(2, 1fr);
    gap:0.6rem;
  ">
    {% for img in pub.images %}
    <div style="
      width:100%;
      aspect-ratio: {{ IMG_RATIO }};
      overflow:hidden;
      border-radius:6px;
      background:#f2f2f2;
    ">
      <img
        src="{{ '/assets/img/publications/' | append: img | relative_url }}"
        style="
          width:100%;
          height:100%;
          object-fit:cover;
          display:block;
        "
      >
    </div>
    {% endfor %}
  </div>

  <!-- RIGHT: text -->
  <div>
    <div style="
      font-size:1.15rem;
      font-weight:500;
      margin-bottom:0.4rem;
    ">
      {{ pub.title }}
    </div>

    <div style="
      font-size:0.95rem;
      margin-bottom:0.25rem;
    ">
      {{ pub.authors }}
    </div>

    <div style="
      font-size:0.95rem;
      font-style:italic;
      color:#444;
      margin-bottom:0.4rem;
    ">
      {{ pub.venue }}
    </div>

    {% if pub.links.ieee %}
      <a href="{{ pub.links.ieee }}">[IEEE]</a>
    {% endif %}
    {% if pub.links.publisher %}
      &nbsp;<a href="{{ pub.links.publisher }}">[Publisher]</a>
    {% endif %}
  </div>

</div>
{% endfor %}
{% endfor %}