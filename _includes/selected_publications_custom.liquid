<h2>Selected Publications</h2>

{% for block in site.data.selected_publications %}
  <h3 class="selected-year">{{ block.year }}</h3>

  {% for pub in block.items %}
    <div class="selected-pub-item">

      <!-- LEFT: Image -->
      <div class="pub-image">
        {% if pub.images and pub.images.size > 0 %}
          <img src="{{ '/assets/img/publications/' | append: pub.images[0] | relative_url }}" alt="{{ pub.title }}">
        {% endif %}
      </div>

      <!-- RIGHT: Info -->
      <div class="pub-info">
        <h4 class="pub-title">{{ pub.title }}</h4>
        <p class="pub-authors">{{ pub.authors }}</p>
        <p class="pub-venue">{{ pub.venue }}</p>

        <div class="pub-links">
          {% if pub.links.ieee %}
            <a href="{{ pub.links.ieee }}" target="_blank">[IEEE]</a>
          {% endif %}
          {% if pub.links.publisher %}
            <a href="{{ pub.links.publisher }}" target="_blank">[Publisher]</a>
          {% endif %}
        </div>
      </div>

    </div>
  {% endfor %}
{% endfor %}