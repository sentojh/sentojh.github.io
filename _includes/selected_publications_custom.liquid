{%- comment -%}
====================================================
SELECTED PUBLICATIONS — SINGLE IMAGE VERSION
모든 레이아웃 / 간격 / 크기 여기서 제어
====================================================
{%- endcomment -%}

{%- assign IMG_WIDTH = "360px" -%}
{%- assign IMG_RATIO = "4 / 3" -%}
{%- assign GAP = "2.5rem" -%}
{%- assign ITEM_MARGIN = "3.8rem" -%}


{% for block in site.data.selected_publications %}

<h3 style="
  margin-top:3.2rem;
  margin-bottom:1.4rem;
  font-size:1.9rem;
  font-weight:500;
">
  {{ block.year }}
</h3>

{% for pub in block.items %}
<div style="
  display:grid;
  grid-template-columns: {{ IMG_WIDTH }} 1fr;
  column-gap: {{ GAP }};
  margin-bottom: {{ ITEM_MARGIN }};
  align-items:start;
">

  <!-- LEFT: single image -->
  <div style="
    width:100%;
    aspect-ratio: {{ IMG_RATIO }};
    overflow:hidden;
    border-radius:10px;
    background:#f2f2f2;
  ">
    <img
      src="{{ '/assets/img/publications/' | append: pub.images[0] | relative_url }}"
      style="
        width:100%;
        height:100%;
        object-fit:cover;
        display:block;
      "
    >
  </div>

  <!-- RIGHT: info -->
  <div>
    <div style="
      font-size:1.4rem;
      font-weight:500;
      margin-bottom:0.6rem;
      line-height:1.35;
    ">
      {{ pub.title }}
    </div>

    <div style="
      font-size:1.2rem;
      margin-bottom:0.4rem;
    ">
      {{ pub.authors }}
    </div>

    <div style="
      font-size:1.15rem;
      color:#222;   /* italic 제거 + 색 조금 진하게 */
      margin-bottom:0.7rem;
    ">
      {{ pub.venue }}
    </div>

    {% if pub.links.ieee %}
      <a href="{{ pub.links.ieee }}">[IEEE]</a>
    {% endif %}
    {% if pub.links.publisher %}
      &nbsp;<a href="{{ pub.links.publisher }}">[Publisher]</a>
    {% endif %}
  </div>

</div>
{% endfor %}
{% endfor %}
